# Application
APP_ENV=development
APP_MODE=spec

# Database
# Required in Phase 2 when APP_MODE=record.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/polymarket_scalper

# Optional. Not required in Phase 2.
REDIS_URL=

# Logging / Runtime
LOG_LEVEL=INFO
TIMEZONE=UTC

# Polymarket Public / Network Configuration
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com/
POLYMARKET_RELAYER_CHAIN_ID=137
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=2

# Polymarket Contract Addresses
POLYMARKET_CTF_ADDRESS=0x4d97dcd97ec945f40cf65f87097ace5ea0476045
POLYMARKET_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Underlying Price Provider
# Phase 2 uses public data only. No API key is required for Polymarket RTDS.
CRYPTO_PRICE_PROVIDER=polymarket_rtds
CRYPTO_PRICE_API_KEY=
RECORDER_UNDERLYING_PRICE_PROVIDER=polymarket_rtds

# Recorder Settings
SUPPORTED_ASSETS=BTC,ETH,SOL,BNB,XRP
RECORDER_SNAPSHOT_INTERVAL_SECONDS=1
RECORDER_MARKET_REFRESH_INTERVAL_SECONDS=60
RECORDER_MAX_MARKETS_PER_ASSET=1
# Phase 2 records the current live 15-minute market per asset and rolls forward on expiry.
RECORDER_WRITE_RAW_PAYLOADS=true

# Strategy Defaults
MAX_POSITION_SIZE_USD=10
DAILY_MAX_LOSS_USD=50

# Builder Credentials
# Not used in Phase 2.
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASS_PHRASE=

# Trading Wallet
# Not used in Phase 2.
# Never commit real values.
FUNDER_ADDRESS=
PRIVATE_KEY=
